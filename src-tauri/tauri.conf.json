{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SENU",
  "version": "0.9.0-beta.1",
  "identifier": "app.senu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SENU",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#13141C",
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: ipc:; style-src 'self' 'unsafe-inline' https: blob:; script-src 'self' 'unsafe-inline' https: blob:; worker-src blob: 'self'; img-src 'self' data: blob: https: http://127.0.0.1:*; frame-src blob: data: http://127.0.0.1:*; connect-src 'self' tauri: ipc: https: blob:; font-src 'self' data: https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Premium SSH terminal for security professionals",
    "longDescription": "SENU is a premium SSH terminal for security professionals — pentesters, bug bounty hunters, DevSecOps, and corporate security teams.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQkQ0NUM5MkRFOEZDNzIKUldSeS9PZ3R5VVc5MnBXdGZaTjkra1BnTHM1T2Y0SDhoZC9wTzBlQldENjlzemRUZDJuRktpNFcK",
      "endpoints": [
        "https://github.com/St3llArS33R/senu/releases/latest/download/latest.json"
      ]
    }
  }
}
